<?xml version="1.0" encoding="utf-8"?>
<!-- LinearLayout: Root vertical layout for the welcome/onboarding screen -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WelcomeActivity"
    android:background="@color/black"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingEnd="32dp">

    <!-- ImageView: Large decorative icon displayed on the welcome screen -->
    <ImageView
        android:layout_marginTop="180dp"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_gravity="center"
        android:src="@drawable/welcome_icon_final"
        />


    <!-- Button: Navigation button that takes the user to the Login screen -->
    <Button
        android:layout_marginTop="220dp"
        android:id="@+id/login_btn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Login"
        android:textColor="@color/white"
        android:backgroundTint="@color/purple_dark"
        android:textSize="20dp"
        android:layout_gravity="center"/>

    <!-- Button: Navigation button that takes the user to the Registration screen -->
    <Button
        android:id="@+id/Register_btn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:text="Register"
        android:textColor="@color/white"
        android:backgroundTint="@color/purple_dark"
        android:textSize="20dp"
        android:layout_gravity="center"/>

</LinearLayout>