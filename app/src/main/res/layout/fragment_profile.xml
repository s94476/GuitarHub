<?xml version="1.0" encoding="utf-8"?>
<!-- RelativeLayout: Main container for the user profile screen -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- TextView: Label for the email address display -->
    <TextView
        android:id="@+id/tv_email_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Email:" />

    <!-- TextView: Area where the current user's email is displayed -->
    <TextView
        android:id="@+id/tv_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/tv_email_label"
        android:layout_marginStart="8dp" />

    <!-- TextView: Label for the username display -->
    <TextView
        android:id="@+id/tv_username_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_email"
        android:layout_marginTop="8dp"
        android:text="Username:" />

    <!-- TextView: Area where the current user's username is displayed -->
    <TextView
        android:id="@+id/tv_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/tv_username_label"
        android:layout_alignBaseline="@id/tv_username_label"
        android:layout_marginStart="8dp" />

    <!-- Button: Navigation button to go to the password change screen -->
    <Button
        android:id="@+id/btn_change_password"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tv_username"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:text="Change Password" />

</RelativeLayout>