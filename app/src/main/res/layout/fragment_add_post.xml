<?xml version="1.0" encoding="utf-8"?>
<!-- ScrollView: Root container allowing the entire post creation form to be scrollable on smaller screens -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="24dp">

    <!-- LinearLayout: Vertical container for all post input fields -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- EditText: Input field for the song title -->
        <EditText
            android:id="@+id/et_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Song Title" />

        <!-- EditText: Input field for the artist name -->
        <EditText
            android:id="@+id/et_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Artist" />

        <!-- TextView: Label for the genre selection section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Genre (Select from list):" />

        <!-- AutoCompleteTextView: Input field with suggestions for selecting a genre -->
        <AutoCompleteTextView
            android:id="@+id/actv_genre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Start typing genre..." />

        <!-- ChipGroup: Container for selectable genre tags -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_genres"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:singleSelection="true" />

        <!-- LinearLayout: Row for selecting recommended guitar skill level -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- TextView: Label for the skill level spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recommended Level:" />

            <!-- Spinner: Dropdown menu for choosing Beginner, Intermediate, etc. -->
            <Spinner
                android:id="@+id/sp_recommended_level"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- TextView: Section header for Amplifier settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Amp Settings"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />

        <!-- LinearLayout: Row containing Gain, Treble, Bass, and Middle input fields -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- TextView: Label for Gain input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gain:" />

            <!-- EditText: Numeric input for Gain setting (0-10) -->
            <EditText
                android:id="@+id/et_gain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="0/10"
                android:inputType="number" />

            <!-- TextView: Label for Treble input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Treble:" />

            <!-- EditText: Numeric input for Treble setting (0-10) -->
            <EditText
                android:id="@+id/et_treble"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="0/10"
                android:inputType="number" />

            <!-- TextView: Label for Bass input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bass:" />

            <!-- EditText: Numeric input for Bass setting (0-10) -->
            <EditText
                android:id="@+id/et_bass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="0/10"
                android:inputType="number" />

            <!-- TextView: Label for Middle input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Middle:" />

            <!-- EditText: Numeric input for Middle setting (0-10) -->
            <EditText
                android:id="@+id/et_middle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="0/10"
                android:inputType="number" />
        </LinearLayout>

        <!-- EditText: Input field for specifying the amplifier model -->
        <EditText
            android:id="@+id/et_amp_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Amp Name" />

        <!-- LinearLayout: Row containing pickup position and tone knob settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- TextView: Label for pickup position spinner -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Position:" />

            <!-- Spinner: Dropdown menu for choosing guitar pickup position -->
            <Spinner
                android:id="@+id/sp_amp_position"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- TextView: Label for Tone input -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tone:" />

            <!-- EditText: Numeric input for Tone knob setting (0-10) -->
            <EditText
                android:id="@+id/et_tone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="0/10"
                android:inputType="number" />
        </LinearLayout>

        <!-- TextView: Section header for Effects pedal settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Effects"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />

        <!-- LinearLayout: Vertical container where effect input rows are dynamically added -->
        <LinearLayout
            android:id="@+id/effects_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Button: Action button to add a new effect input row to the container -->
        <Button
            android:id="@+id/add_effect_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Add Effect" />

        <!-- Container for AI and Submit buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ai_button"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton.Icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="AI Help"
                app:icon="@drawable/ic_star_filled" />

            <Button
                android:id="@+id/submit_post_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submit" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
