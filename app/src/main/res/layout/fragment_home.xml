<?xml version="1.0" encoding="utf-8"?>
<!-- LinearLayout: Container for the home screen layout elements, arranged vertically -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="24dp">

    <!-- CardView: Provides a rounded, elevated container for the search bar -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <!-- SearchView: Search bar for filtering posts by song title, artist, amp, or genre -->
        <androidx.appcompat.widget.SearchView
            android:id="@+id/search_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:iconifiedByDefault="false"
            app:queryHint="Search songs, artists, amps, genres..."
            android:focusable="true"
            android:clickable="true"
            android:focusableInTouchMode="true" />
    </androidx.cardview.widget.CardView>

    <!-- TabLayout: Tab bar for switching between 'All Posts' and 'Favorites' -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tabGravity="fill"
        app:tabMode="fixed">

        <!-- TabItem: First tab for viewing all available posts -->
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Posts" />

        <!-- TabItem: Second tab for viewing user's favorite posts -->
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Favorites" />

    </com.google.android.material.tabs.TabLayout>

    <!-- RecyclerView: Scrollable list of guitar setup posts -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_posts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"/>

</LinearLayout>