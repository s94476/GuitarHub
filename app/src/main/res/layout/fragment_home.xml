<?xml version="1.0" encoding="utf-8"?>
<!-- LinearLayout: Container for the home screen layout elements, arranged vertically -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/black"
    android:paddingTop="24dp">

    <!-- CardView: Provides a rounded, elevated container for the search bar -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardBackgroundColor="@color/purple_dark"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp">

        <!-- Horizontal container for SearchView and AI button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingEnd="8dp">

            <!-- SearchView: Search bar for filtering posts by song title, artist, amp, or genre -->
            <androidx.appcompat.widget.SearchView
                android:id="@+id/search_view"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:iconifiedByDefault="false"
                app:queryHint="Search songs, artists, amps, genres..."
                app:searchHintIcon="@null"
                app:searchIcon="@null"
                android:theme="@style/ThemeOverlay.AppCompat.Dark" />

            <!-- AI Help Button: Triggers AI-assisted search/logic -->
            <ImageButton
                android:id="@+id/ai_search_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_star_filled"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="AI Help"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/purple_accent" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- TabLayout: Tab bar for switching between 'All Posts' and 'Favorites' -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/black"
        app:tabTextColor="@color/purple_light"
        app:tabSelectedTextColor="@color/white"
        app:tabIndicatorColor="@color/purple_accent"
        app:tabGravity="fill"
        app:tabMode="fixed">

        <!-- TabItem: First tab for viewing all available posts -->
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All Posts" />

        <!-- TabItem: Second tab for viewing user's favorite posts -->
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Favorites" />

    </com.google.android.material.tabs.TabLayout>

    <!-- RecyclerView: Scrollable list of guitar setup posts -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_posts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/black"
        android:clipToPadding="false"/>

</LinearLayout>
